# =============================================================================
# PUSKESMAS MALIMPUNG — HEALTH HUB V2
# Contoh Konfigurasi Produksi Nginx Berstandar Keamanan Pemerintah
# Lokasi Sasaran: /etc/nginx/sites-available/puskesmas-malimpung.conf
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name puskesmas-malimpung.pinrangkab.go.id;

    # Pengalihan otomatis HTTP ke HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name puskesmas-malimpung.pinrangkab.go.id;

    # Dokumen Root Aplikasi
    root /var/www/puskesmas-malimpung;
    index index.html;

    # Konfigurasi Sertifikat SSL / TLS Resmi Pemkab Pinrang
    ssl_certificate /etc/letsencrypt/live/puskesmas-malimpung.pinrangkab.go.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/puskesmas-malimpung.pinrangkab.go.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security Headers (Kepatuhan UU PDP No. 27/2022 & Permenkes No. 24/2022)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';" always;

    # Kompresi Gzip & Performa
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml image/svg+xml;

    # Routing Single Page Application (SPA Fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Caching Agresif untuk Aset Statis Tidak Berubah
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    # Blokir Akses ke File Tersembunyi (.git, .env, dll.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Halaman Kesalahan Khusus
    error_page 404 /index.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
